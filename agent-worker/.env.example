# Investprop realtime voice-agent worker — environment template.
# Copy to .env and fill in. In production these come from the server .env via
# docker-compose, so you normally do NOT keep real secrets in this folder.

# LiveKit Cloud project (wss URL + API key/secret). Same values as the server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI key for the Realtime model (same key as the server's OPENAI_API_KEY).
OPENAI_API_KEY=

# Where the worker calls the authenticated office action bridge.
# In production this is the internal container URL, e.g. http://app:8010.
BACKEND_URL=http://localhost:8010

# Shared secret presented to /api/office-agent/execute (must match server .env).
AGENT_SHARED_SECRET=

# Must match VOICE_AGENT_NAME in the server .env so explicit dispatch reaches it.
VOICE_AGENT_NAME=investprop-office-agent

# Realtime voice (OpenAI voices: alloy, echo, shimmer, ...).
VOICE_AGENT_VOICE=alloy
