enum SubscriptionTier {
  FREE
  INVESTOR_PLUS
  PRO
  ENTERPRISE
  DISTRESSED // standalone "DistressedDeals SA" product SKU
  SELLER_PRO // standalone seller / landlord product SKU (supply side)
