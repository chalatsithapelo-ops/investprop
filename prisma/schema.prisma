enum ShareOrderSide {
  BUY
  SELL
}

enum ShareOrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
}

// Lifecycle of a matched secondary trade awaiting Delivery-versus-Payment.
enum TradeSettlementStatus {
  PENDING_PAYMENT // matched; seller shares reserved; awaiting buyer EFT
  POP_SUBMITTED   // buyer uploaded proof of payment; awaiting manager review
  SETTLED         // shares delivered + cash confirmed
  REJECTED        // manager rejected the proof of payment
  EXPIRED         // payment window elapsed before settlement
  CANCELLED       // cancelled by admin/system
}

// ─── Phase 2: Legal Documents Model ─────────────────────────────

model LegalDocument {
  id             Int            @id @default(autoincrement())
  propertyId     Int
  spvId          Int?
  documentType   LegalDocType
  title          String
  content        String         @db.Text // Generated document content (HTML/markdown)
  documentUrl    String? // Stored file URL if uploaded/signed
  status         LegalDocStatus @default(DRAFT)
  generatedFor   Int? // User ID this doc is for (e.g. share certificate for investor)
  metadata       Json? // Flexible: { signatories, shareCount, etc. }
  signedAt       DateTime?
  expiresAt      DateTime?
  // AI Strategy 1.3 — plain-language summarisation
  aiSummary      String?        @db.Text // 3-bullet plain-language summary
  aiKeyClauses   Json? // [{clause, plainEnglish, severity}]
  aiGlossary     Json? // [{term, definition}]
  aiRiskFlags    Json? // [{category, severity, detail, recommendation}] — structured SA-compliance risk register
  aiRiskLevel    String? // LOW | MODERATE | HIGH — overall document risk
  aiSummarisedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  spv            SPV?           @relation(fields: [spvId], references: [id])

  @@index([propertyId])
  @@index([documentType])
  @@index([generatedFor])
}

// ─── Phase 3: Property Financial Tracking ───────────────────────

model PropertyFinancialEntry {
  id            Int                @id @default(autoincrement())
  propertyId    Int
  type          FinancialEntryType
  category      FinancialCategory
  amount        Float
  description   String
  date          DateTime
  reference     String? // Invoice number, receipt reference, etc.
  attachmentUrl String?
  recordedById  Int
  period        String? // e.g. "2026-02" for monthly reporting
  createdAt     DateTime           @default(now())
  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  recordedBy    User               @relation(fields: [recordedById], references: [id])

  @@index([propertyId])
  @@index([type])
  @@index([date])
  @@index([period])
}

// ─── Phase 7: Share Marketplace ─────────────────────────────────

model ShareOrder {
  id             Int              @id @default(autoincrement())
  shareClassId   Int
  investorId     Int
  side           ShareOrderSide // BUY or SELL
  quantity       Int // Number of shares
  filledQuantity Int              @default(0)
  pricePerShare  Float // Asking/bid price
  status         ShareOrderStatus @default(OPEN)
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  shareClass     ShareClass       @relation(fields: [shareClassId], references: [id])
  investor       User             @relation(fields: [investorId], references: [id])
  trades         ShareTrade[]     @relation("OrderAsTaker")
  makerTrades    ShareTrade[]     @relation("OrderAsMaker")

  @@index([shareClassId, side, status])
  @@index([investorId])
}

model ShareTrade {
  id            Int        @id @default(autoincrement())
  shareClassId  Int
  buyOrderId    Int
  sellOrderId   Int
  buyerId       Int
  sellerId      Int
  quantity      Int
  pricePerShare Float
  totalAmount   Float
  executedAt    DateTime   @default(now())
  shareClass    ShareClass @relation(fields: [shareClassId], references: [id])
  buyOrder      ShareOrder @relation("OrderAsTaker", fields: [buyOrderId], references: [id])
  sellOrder     ShareOrder @relation("OrderAsMaker", fields: [sellOrderId], references: [id])

  @@index([shareClassId])
  @@index([executedAt])
}

model SharePriceHistory {
  id           Int        @id @default(autoincrement())
  shareClassId Int
  price        Float
  volume       Int        @default(0) // shares traded in period
  recordedAt   DateTime   @default(now())
  shareClass   ShareClass @relation(fields: [shareClassId], references: [id])

  @@index([shareClassId, recordedAt])
}

// Escrow record for a matched secondary trade settling under Delivery-versus-Payment.
// Seller shares are reserved on creation; ownership moves only on manager confirmation.
model ShareTradeSettlement {
  id                    Int                   @id @default(autoincrement())
  shareClassId          Int
  buyOrderId            Int
  sellOrderId           Int
  buyerId               Int
  sellerId              Int
  quantity              Int
  pricePerShare         Float
  totalAmount           Float // cash the buyer owes the seller (quantity * pricePerShare)
  platformFee           Float                 @default(0) // SECONDARY_TRADE fee booked on settlement
  securitiesTransferTax Float                 @default(0) // STT (~0.25%) on the transfer value
  status                TradeSettlementStatus @default(PENDING_PAYMENT)
  proofOfPaymentUrl     String?
  paymentReference      String?
  paymentSubmittedAt    DateTime?
  reviewedById          Int?
  reviewedAt            DateTime?
  reviewNotes           String?
  expiresAt             DateTime? // payment window; auto-expires the reservation if unpaid
  settledTradeId        Int? // links to the ShareTrade once settled
  reversedAt            DateTime?
  reversedById          Int?
  reversedReason        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  shareClass            ShareClass            @relation(fields: [shareClassId], references: [id])
  buyer                 User                  @relation("SettlementBuyer", fields: [buyerId], references: [id])
  seller                User                  @relation("SettlementSeller", fields: [sellerId], references: [id])

  @@index([shareClassId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

// ─── Wallet (in-app cash balance for instant DvP settlement) ────
// Balances and transaction amounts are stored in integer CENTS (ZAR) to avoid
// floating-point drift. A wallet's balance equals the running balanceAfter of
// its most recent COMPLETED transaction — the transaction ledger is the source
// of truth and the balance column is a cached projection kept in lock-step.
model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique
  balanceCents Int                 @default(0) // authoritative cash balance in cents (ZAR)
  currency     String              @default("ZAR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id           Int                 @id @default(autoincrement())
  walletId     Int
  type         WalletTxnType
  amountCents  Int // signed: positive = credit, negative = debit
  balanceAfter Int // running wallet balance (cents) after this transaction
  status       WalletTxnStatus     @default(COMPLETED)
  reference    String?             @unique // Paystack ref / internal idempotency key
  description  String?
  settlementId Int? // ShareTradeSettlement this txn relates to (trade legs)
  withdrawalId Int? // WalletWithdrawal this txn relates to
  createdAt    DateTime            @default(now())
  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([settlementId])
  @@index([withdrawalId])
  @@index([status])
}

model WalletWithdrawal {
  id                   Int               @id @default(autoincrement())
  userId               Int
  amountCents          Int // cents requested
  status               WithdrawalStatus  @default(REQUESTED)
  bankName             String?
  accountNumber        String?
  accountName          String?
  branchCode           String?
  reference            String?           @unique
  paystackTransferCode String?
  reviewedById         Int?
  reviewedAt           DateTime?
  reviewNotes          String?
  processedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum WalletTxnType {
  DEPOSIT // funded via Paystack (EFT/card)
  WITHDRAWAL // payout to bank
  TRADE_DEBIT // buyer paying for shares at settlement
  TRADE_CREDIT // seller receiving proceeds at settlement
  FEE // platform fee / STT collected
  REFUND // settlement cancel/expiry/reversal or withdrawal rejection
  ADJUSTMENT // manual admin correction
}

enum WalletTxnStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

// ─── Contractor Management ──────────────────────────────────────

model ContractorProfile {
  id                     Int                  @id @default(autoincrement())
  userId                 Int                  @unique
  companyName            String
  tradingAs              String?
  registrationNumber     String? // CIPC registration
  vatNumber              String?
  beeLevel               String? // B-BBEE level
  specialty              String // e.g. "General Building", "Plumbing", "Electrical"
  phone                  String
  address                String?
  city                   String?
  province               String?
  bankName               String?
  bankAccountNumber      String?
  bankBranchCode         String?
  insuranceExpiry        DateTime?
  cidbGrade              String? // CIDB grading (SA construction industry)
  // Phase 11: contractor compliance
  taxClearanceNumber     String? // SARS Tax Compliance Status PIN
  taxClearanceExpiry     DateTime?
  publicLiabilityInsurer String?
  publicLiabilityCover   Float? // R-amount cover
  publicLiabilityExpiry  DateTime?
  workersCompCoid        String? // COIDA registration number
  notes                  String?
  profileStatus          String               @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason        String?
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt
  user                   User                 @relation(fields: [userId], references: [id])
  rfqResponses           RFQResponse[]
  workOrders             WorkOrder[]
  contractorInvoices     ContractorInvoice[]
  documents              ContractorDocument[]

