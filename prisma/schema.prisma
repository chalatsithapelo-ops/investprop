  @@index([status])
  @@index([deadline])
}

model RFQResponse {
  id                  Int               @id @default(autoincrement())
  rfqId               Int
  contractorProfileId Int
  quotedAmount        Float
  proposedTimeline    String? // e.g. "4 weeks"
  notes               String?           @db.Text
  attachmentUrls      Json? // Quote PDFs
  status              RFQResponseStatus @default(SUBMITTED)
  reviewNotes         String?
  reviewedById        Int?
  reviewedAt          DateTime?
  submittedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  rfq                 RFQ               @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  contractorProfile   ContractorProfile @relation(fields: [contractorProfileId], references: [id])

  @@unique([rfqId, contractorProfileId])
  @@index([rfqId])
  @@index([contractorProfileId])
}

model WorkOrder {
  id                  Int                 @id @default(autoincrement())
  rfqId               Int?                @unique
  propertyId          Int
  contractorProfileId Int
  title               String
  description         String              @db.Text
  agreedAmount        Float
  startDate           DateTime
  expectedEndDate     DateTime
  actualEndDate       DateTime?
  status              WorkOrderStatus     @default(ISSUED)
  notes               String?
  issuedById          Int
  // Phase 12: acceptance + retention
  acceptedAt          DateTime?
  acceptedSignature   String? // Typed full name as e-signature
  retentionPercent    Float               @default(0) // Typical 5-10% for SA construction
  retentionAmount     Float               @default(0)
  retentionReleasedAt DateTime?
  hsFileUrl           String? // Health-and-safety file (OHS Act §37(2))
  completionRating    Int?
  completionNotes     String?             @db.Text
  ratedById           Int?
  ratedAt             DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  rfq                 RFQ?                @relation(fields: [rfqId], references: [id])
  property            Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractorProfile   ContractorProfile   @relation(fields: [contractorProfileId], references: [id])
  issuedBy            User                @relation("WorkOrderIssuedBy", fields: [issuedById], references: [id])
  ratedBy             User?               @relation("WorkOrderRatedBy", fields: [ratedById], references: [id])
  invoices            ContractorInvoice[]
  updates             WorkOrderUpdate[]
  variations          VariationOrder[]

  @@index([propertyId])
  @@index([contractorProfileId])
  @@index([status])
}

// Phase 12 — Variation orders (scope/cost changes during a work order)
model VariationOrder {
  id              Int                  @id @default(autoincrement())
  workOrderId     Int
  number          String // e.g. VO-001
  description     String               @db.Text
  costImpact      Float // Positive = increase, negative = credit
  timeImpactDays  Int                  @default(0)
  status          VariationOrderStatus @default(PROPOSED)
  proposedById    Int
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  workOrder       WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  proposedBy      User                 @relation("VariationProposedBy", fields: [proposedById], references: [id])
  approvedBy      User?                @relation("VariationApprovedBy", fields: [approvedById], references: [id])

  @@index([workOrderId])
  @@index([status])
}

enum VariationOrderStatus {
  PROPOSED
  APPROVED
  REJECTED
  WITHDRAWN
}

model WorkOrderUpdate {
  id            Int       @id @default(autoincrement())
