  @@index([isActive])
  @@index([profileStatus])
}

model ContractorDocument {
  id                  Int               @id @default(autoincrement())
  contractorProfileId Int
  documentType        String // CIPC_REGISTRATION, BEE_CERTIFICATE, CIDB_CERTIFICATE, TAX_CLEARANCE, INSURANCE, PROOF_OF_BANKING, OTHER
  documentName        String
  documentUrl         String
  createdAt           DateTime          @default(now())
  contractorProfile   ContractorProfile @relation(fields: [contractorProfileId], references: [id])

  @@index([contractorProfileId])
}

model RFQ {
  id              Int           @id @default(autoincrement())
  propertyId      Int
  milestoneId     Int?
  title           String
  scopeOfWork     String        @db.Text
  estimatedBudget Float?
  deadline        DateTime // Deadline for quotes
  status          RFQStatus     @default(OPEN)
  imageUrls       Json? // Scope photos
  attachmentUrls  Json? // PDF specs etc.
  createdById     Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  milestone       Milestone?    @relation(fields: [milestoneId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])
  responses       RFQResponse[]
  workOrder       WorkOrder?

