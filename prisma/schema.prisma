  @@index([createdAt])
  @@index([urgencyLevel])
}

// ─── Land-into-SPV Partnership (landowner brings land as equity) ──
// A landowner contributes their land/property into a ring-fenced SPV in
// exchange for a minority equity stake (default 20%). The platform does
// all the work (funding, rezoning, development, sale). The agreement is
// reviewed, signed in-app, and printed with the owner's details auto-filled.

enum LandPartnershipStatus {
  SUBMITTED // owner submitted the land
  UNDER_REVIEW // acquisitions team assessing
  APPROVED // approved; terms set, agreement generated
  AGREEMENT_READY // agreement generated, awaiting owner signature
  SIGNED // owner has e-signed
  COUNTERSIGNED // platform has countersigned
  SPV_FORMED // SPV incorporated, land contribution underway
  ACTIVE // live partnership
  REJECTED
  WITHDRAWN
}

model LandPartnership {
  id                    Int                   @id @default(autoincrement())
  ownerId               Int
  referenceCode         String                @unique // LP-YYYY-####
  // ── Landowner / contact ──
  ownerFullName         String
  ownerIdNumber         String?
  ownerPhone            String?
  ownerEmail            String?
  ownerAddress          String?
  // ── Entity (if land held in a company / trust) ──
  ownerEntityName       String?
  ownerEntityRegNumber  String?
  // ── Land / property ──
  landTitle             String
  landDescription       String                @db.Text
  address               String
  city                  String
  province              String                @default("Gauteng")
  erfNumber             String?
  titleDeedNumber       String?
  erfSize               Float? // sqm
  currentZoning         String?
  currentUse            String?
  municipalValue        Float?
  estimatedLandValue    Float?
  bondStatus            BondStatus            @default(NONE)
  bondOutstanding       Float?
  bondBank              String?
  ratesStatus           RatesStatus           @default(CURRENT)
  ratesArrears          Float?
  coOwners              String? // additional registered owners
  // ── Proposed development ──
  developmentType       String? // Residential estate, Flats, Commercial, Flip, etc.
  intendedStrategy      String? // DEVELOP | FLIP | HOLD
  proposedUnits         Int?
  estimatedGDV          Float? // Gross development value
  estimatedBuildCost    Float?
  // ── Equity split ──
  ownerEquityPct        Float                 @default(20)
  platformEquityPct     Float                 @default(80)
  // ── Documents / media ──
  documentUrls          Json? // [{kind, url, name}]
  imageUrls             Json?
  // ── Consent ──
  popiaConsent          Boolean               @default(false)
  // ── Workflow ──
  status                LandPartnershipStatus @default(SUBMITTED)
  reviewedById          Int?
  reviewNotes           String?               @db.Text
  reviewedAt            DateTime?
  rejectedReason        String?               @db.Text
  // ── Agreement + e-signature ──
  agreementContent      String?               @db.Text // generated, auto-filled agreement
  agreementGeneratedAt  DateTime?
  ownerSignatureName    String? // typed full name used as signature
  ownerSignatureId      String? // ID number captured at signing
  ownerSignedAt         DateTime?
  ownerSignatureIp      String?
  ownerSignatureData    String?               @db.Text // optional drawn signature (base64)
  platformSignatoryName String?
  platformSignedAt      DateTime?
  // ── SPV / property bridge ──
  spvId                 Int?
  spvFormedAt           DateTime?
  convertedToPropertyId Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  owner                 User                  @relation("LandPartnershipOwner", fields: [ownerId], references: [id])
  reviewedBy            User?                 @relation("LandPartnershipReviewedBy", fields: [reviewedById], references: [id])
  spv                   SPV?                  @relation(fields: [spvId], references: [id])

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

/// Immutable ledger of every platform fee captured across the app.
/// Each row represents realized platform revenue (ZAR) booked at the
/// moment money moved (capital raise, distribution, secondary trade,
/// property sourcing). This is the single source of truth for revenue
/// reporting in the admin dashboard.
model PlatformRevenue {
  id          Int      @id @default(autoincrement())
  feeType     String // CAPITAL_RAISE | DISTRIBUTION | SECONDARY_TRADE | SOURCING
  sourceType  String // InvestorContribution | Distribution | ShareTrade | Acquisition
  sourceId    Int // id of the originating record
  propertyId  Int?
  baseAmount  Float // the amount the fee was calculated on (ZAR)
  feeBps      Int // basis points applied (100 bps = 1%)
  feeAmount   Float // realized platform fee (ZAR)
  currency    String   @default("ZAR")
  description String?
  createdAt   DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([feeType, sourceType, sourceId])
  @@index([feeType])
  @@index([sourceType, sourceId])
  @@index([propertyId])
  @@index([createdAt])
}

/// Singleton configuration (id = 1) for platform fee rates. Admin-editable
/// from the revenue dashboard. All rates are in basis points (100 = 1%).
model PlatformFeeConfig {
  id                   Int      @id @default(autoincrement())
  capitalRaiseFeeBps   Int      @default(250) // 2.5% on investor contributions
  distributionFeeBps   Int      @default(200) // 2.0% management fee booked on distributions
  secondaryTradeFeeBps Int      @default(100) // 1.0% on secondary share trades
  sourcingFeeBps       Int      @default(100) // 1.0% on property acquisition price
  sourcingFlatFee      Float    @default(0) // optional flat sourcing fee (ZAR); used when > 0
  // ─── Owner (seller-side) monetization ───
  sellerFacilitationFeeBps Int   @default(200) // 2.0% facilitation fee on a successful owner sale
  assessmentPackFee        Float @default(2500) // flat due-diligence / valuation pack fee (ZAR)
  jvPromoteFeeBps          Int   @default(1000) // 10% promote on owner JV / partnership distributions
  leaseBackSetupFee        Float @default(5000) // flat lease-back arrangement setup fee (ZAR)
  leaseBackMgmtFeeBps      Int   @default(800) // 8% rental-management margin on lease-back income
  bondReferralFee          Float @default(0) // flat bond / conveyancing referral commission (ZAR)
  enabled              Boolean  @default(true) // master switch for fee capture
  updatedAt            DateTime @default(now()) @updatedAt
  updatedById          Int?
}

