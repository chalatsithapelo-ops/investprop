 * - INTEREST     0% (investor declares, IT3b)
 * - CAPITAL_GAIN 0% (investor declares CGT)
 */
enum TaxClassification {
  DIVIDEND
  RENTAL_INCOME
  INTEREST
  CAPITAL_GAIN
}

enum DistributionStatus {
