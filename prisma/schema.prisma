  contactEmail   String?
  contactPhone   String?
  commissionBps  Int                 @default(0) // % of deal value, in basis points
  commissionFlat Float               @default(0) // flat ZAR per conversion
  active         Boolean             @default(true)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  leads          ReferralLead[]
}

/// Commission ledger — each lead sent to a partner; commissionAmount realized
/// when status becomes CONVERTED.
model ReferralLead {
  id               Int                @id @default(autoincrement())
  partnerId        Int
  userId           Int?
  listingId        Int?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  status           ReferralLeadStatus @default(NEW)
  estimatedValue   Float? // deal size used for commission calc
  commissionAmount Float              @default(0) // realized on CONVERTED
  convertedAt      DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  partner          ReferralPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id])

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

/// Affordability band for a home-loan prequalification result.
enum PrequalificationBand {
  STRONG
  MODERATE
  WEAK
}

/// Home-loan prequalification — an INDICATIVE in-app affordability check an
/// investor runs against a property deal. NOT a credit approval. Phase 2 will
/// turn qualifying results into actual multi-bank applications via a bond
/// originator partner (see home-loan-feature memory).
model Prequalification {
  id                   Int                  @id @default(autoincrement())
  userId               Int
  propertyId           Int?
  // Applicant inputs (ZAR, monthly unless noted)
  grossMonthlyIncome   Float
  netMonthlyIncome     Float                @default(0)
  monthlyExpenses      Float                @default(0)
  existingDebtRepayments Float              @default(0)
  depositAmount        Float                @default(0)
  propertyPrice        Float                @default(0)
  // Assumptions used for the calc
  annualInterestRate   Float                @default(11.75)
  loanTermYears        Int                  @default(20)
  // Computed indicative result
  maxInstalment        Float                @default(0)
  maxBondAmount        Float                @default(0)
  maxPropertyPrice     Float                @default(0)
  estimatedInstalment  Float                @default(0)
  loanToValue          Float                @default(0)
  band                 PrequalificationBand @default(WEAK)
  qualifies            Boolean              @default(false)
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
}

/// Lifecycle of a one-button multi-bank home-loan application handed to a
/// bond-originator partner (Phase 2). We stay a REFERRER — the originator
/// holds the NCA/FSP licence and submits to all major banks.
enum HomeLoanApplicationStatus {
  SUBMITTED // received by us, awaiting originator hand-off
  BANKS_REVIEWING // originator has submitted to the banks
  OFFERS_IN // one or more bank offers returned
  ACCEPTED // applicant accepted an offer
  DECLINED // all banks declined / applicant did not qualify
  WITHDRAWN // applicant withdrew the application
}

/// Status of a single bank's offer on an application.
enum HomeLoanOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
}

/// A multi-bank home-loan application. Created from a (usually qualifying)
/// prequalification; books a ReferralLead against the active BOND_ORIGINATOR
/// partner so commission is realised when the deal converts.
model HomeLoanApplication {
  id                 Int                        @id @default(autoincrement())
  userId             Int
  prequalificationId Int?
  propertyId         Int?
  referralLeadId     Int?
  // Snapshot of what the applicant is applying for (ZAR)
  requestedBondAmount Float                     @default(0)
  propertyPrice      Float                      @default(0)
  depositAmount      Float                      @default(0)
  grossMonthlyIncome Float                      @default(0)
  estimatedInstalment Float                     @default(0)
  annualInterestRate Float                      @default(11.75)
  loanTermYears      Int                        @default(20)
  // Hand-off + lifecycle
  originatorName     String?
  status             HomeLoanApplicationStatus  @default(SUBMITTED)
  consentShareData   Boolean                    @default(false)
  applicantPhone     String?
  notes              String?
  statusNote         String?
  submittedAt        DateTime                   @default(now())
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @default(now()) @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers             HomeLoanOffer[]
  documents          HomeLoanDocument[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Type of supporting document attached to a home-loan application.
enum HomeLoanDocumentType {
  PAYSLIP
  BANK_STATEMENT
  ID_DOCUMENT
  PROOF_OF_ADDRESS
  OFFER_TO_PURCHASE
  OTHER
}

/// A supporting document (payslip, bank statement, etc.) the applicant
/// submits with a home-loan application for the originator / banks.
model HomeLoanDocument {
  id            Int                  @id @default(autoincrement())
  applicationId Int
  docType       HomeLoanDocumentType @default(OTHER)
  fileName      String
  fileUrl       String
  createdAt     DateTime             @default(now())
  application   HomeLoanApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

/// A single bank's offer returned (via the originator) on an application.
model HomeLoanOffer {
  id              Int                 @id @default(autoincrement())
  applicationId   Int
  bankName        String
  approvedAmount  Float               @default(0)
  annualInterestRate Float            @default(0)
  monthlyInstalment Float             @default(0)
  loanTermYears   Int                 @default(20)
  status          HomeLoanOfferStatus @default(OFFERED)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  application     HomeLoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

enum SaleUrgency {
  URGENT // Distressed / immediate sale needed
  HIGH // Within 1-2 months
  STANDARD // Normal timeline
}

enum SaleType {
  CASH
  BOND
  INSTALLMENT
}

enum SaleProposalStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum EngagementType {
  OUTRIGHT_SALE // We buy the property outright
  JOINT_VENTURE // Owner contributes property as equity into a JV / SPV
  LEASE_BACK // We buy and rent back to owner
  DEVELOPMENT_PARTNERSHIP // We develop together, share returns
}

enum BondStatus {
  NONE
  EXISTING
}

enum RatesStatus {
  CURRENT
  ARREARS
}

enum TenancyStatus {
  OWNER_OCCUPIED
  TENANTED
  VACANT
}

enum PropertyCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_RENOVATION
  DISTRESSED
}

enum PropertyRiskRating {
  LOW
  MEDIUM
  HIGH
}

// ---------------------------------------------------------------
// AI Strategy models (Tier 1 � Tier 3)
// ---------------------------------------------------------------

model AIUsageLog {
  id               Int      @id @default(autoincrement())
  userId           Int?
  feature          String // chat | underwriting | doc-summary | listing-coach | portfolio | photo-check | distress | sponsor-track | update-draft | analyze-property
  model            String // e.g. openai/gpt-4o-mini
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  latencyMs        Int      @default(0)
  status           String   @default("OK") // OK | ERROR | RATE_LIMITED
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
}

model PropertyChatMessage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  userId     Int
  role       String // user | assistant | system
  content    String   @db.Text
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId, userId, createdAt])
}

model PortfolioInsight {
  id          Int       @id @default(autoincrement())
  investorId  Int
  period      String // YYYY-MM
  summary     String    @db.Text
  insights    Json // [{type, severity, message, action?}]
  generatedAt DateTime  @default(now())
  dismissedAt DateTime?
  notifiedAt  DateTime? // set when the watchdog has pushed this insight (in-app + email)
  investor    User      @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([investorId, period])
  @@index([investorId, generatedAt])
}

model ConstructionPhotoCheck {
  id            Int      @id @default(autoincrement())
  propertyId    Int
  milestoneId   Int?
  submissionId  Int?
  photoUrls     Json // string[]
  expectedState String   @db.Text // what milestone claims
  verdict       String // GREEN | AMBER | RED
  confidence    Float    @default(0) // 0..1
  narrative     String   @db.Text
  flags         Json? // [{category, description}]
  generatedAt   DateTime @default(now())
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, generatedAt])
  @@index([milestoneId])
}

model InvestorUpdateDraft {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  period      String // YYYY-MM
  subject     String
  bodyHtml    String    @db.Text
  bodyText    String    @db.Text
  status      String    @default("DRAFT") // DRAFT | SENT | CANCELLED
  sentAt      DateTime?
  sentById    Int?
  generatedAt DateTime  @default(now())
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sentBy      User?     @relation("InvestorUpdateSentBy", fields: [sentById], references: [id])

  @@unique([propertyId, period])
  @@index([propertyId, status])
}

model DistressPrediction {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  score       Float // 0..100, higher = more distressed risk
  band        String // LOW | MODERATE | ELEVATED | HIGH
  drivers     Json // [{factor, weight, value, narrative}]
  narrative   String   @db.Text
  generatedAt DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, generatedAt])
  @@index([band])
}

// Lightweight register of AI predictions for later calibration against outcomes.
model AiPrediction {
  id          Int       @id @default(autoincrement())
  kind        String // UNDERWRITING_GRADE | DISTRESS_SCORE | SELLER_VALUATION | MATCH_SCORE
  subjectType String // Property | OwnerSaleProposal | DistressedListing
  subjectId   Int
  userId      Int?
  modelId     String?
  confidence  String? // grade letter / LOW|MEDIUM|HIGH / band, per kind
  predicted   Json // the structured prediction at the time
  outcome     Json? // recorded later when the real-world result is known
  outcomeAt   DateTime?
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([kind, subjectId])
  @@index([subjectType, subjectId])
  @@index([resolved])
  @@index([createdAt])
}

